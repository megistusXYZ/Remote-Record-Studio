# Vessel — runtime configuration
#
# Copy this file to `.env.local` and adjust the values to point at the
# infrastructure you want Vessel to use. None of these are secrets — they all
# ship to the browser via Vite's `import.meta.env`.

# --- Branding -----------------------------------------------------------------

VITE_APP_NAME=Vessel
VITE_APP_TAGLINE=Your voice. Your studio. Your files.

# --- Live media transport (low-latency studio preview) -----------------------
# Public test relay run by the MoQ working group. For production / private use,
# self-host one — see README "Self-hosting" section.

VITE_MOQ_RELAY_URL=wss://relay.quic.video

# --- Long-term file storage ---------------------------------------------------
# Where finalized recordings are uploaded. Replace with your own server for
# full ownership. https://github.com/hzrd149/blossom

VITE_BLOSSOM_SERVER=https://blossom.primal.net

# --- Identity + share metadata relays ----------------------------------------
# Comma-separated list. Vessel will broadcast share archives to every relay in
# the list and read from any of them. https://nostr.watch

VITE_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
