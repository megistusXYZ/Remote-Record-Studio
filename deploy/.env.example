# Vessel production settings. Copy to deploy/.env (git-ignored) and fill in.
# The compose file refuses to start without the required values.
# Full walkthrough: OPERATIONS.md § 10.

# --- Domain -------------------------------------------------------------------
# The site. Bare hostname; the stack obtains TLS certificates itself.
VESSEL_DOMAIN=vessel.example.com
# Sync and storage servers get their own hostnames (A records to this host).
# Defaults: relay.<domain> and files.<domain>. Bare hostnames, no scheme.
#VESSEL_RELAY_DOMAIN=relay.vessel.example.com
#VESSEL_FILES_DOMAIN=files.vessel.example.com
# Let's Encrypt account address (certificate expiry notices go here).
ACME_EMAIL=you@example.com

# --- Secrets ------------------------------------------------------------------
# Generate each one with: openssl rand -hex 32
POSTGRES_PASSWORD=
TURN_SHARED_SECRET=

# --- Live preview: TURN ---------------------------------------------------------
# The turn service listens on the host's own network interface. Point these
# at a DNS-only turn.<domain> record (never proxied through the CDN).
TURN_URLS=turn:turn.vessel.example.com:3478?transport=udp,turn:turn.vessel.example.com:3478?transport=tcp
TURN_TTL_SECONDS=43200
#TURN_MIN_PORT=49160
#TURN_MAX_PORT=49200
# Override the public STUN defaults if you must.
#STUN_URLS=

# --- Browser defaults (not secret) ----------------------------------------------
# Sync servers the app uses by default. Default: this deployment's own.
# Add public ones after it so share links resolve from anywhere.
#VESSEL_RELAYS=wss://relay.vessel.example.com,wss://relay.damus.io,wss://nos.lol
# Default storage server for new studios. Default: this deployment's own.
#VESSEL_STORAGE_SERVER=https://files.vessel.example.com
# Optional higher-capacity live preview relay (see artifacts/vessel/.env.example).
#VESSEL_MOQ_RELAY_URL=
# Content-Security-Policy: keep Report-Only until a week of clean reports.
VESSEL_CSP_ENFORCE=false

# --- Images ---------------------------------------------------------------------
# Where images are pulled from; a release tag such as v0.3.0 pins a version.
#VESSEL_IMAGE_PREFIX=ghcr.io/megistusxyz/remote-record-studio
#VESSEL_IMAGE_TAG=latest

# --- Operations -----------------------------------------------------------------
LOG_LEVEL=info
# Per-IP limits and quotas: observe (log only) first, enforce after a week.
VESSEL_RATE_LIMIT_MODE=observe
BACKUP_KEEP_DAYS=14
# Address ranges allowed to set the visitor IP (X-Forwarded-For). Default:
# Cloudflare's. Nothing in front of the host? Set 192.0.2.1/32.
#TRUSTED_PROXY_RANGES=
# Host ports for the edge; change only for a local run beside another server.
#WEB_HTTP_PORT=80
#WEB_HTTPS_PORT=443
