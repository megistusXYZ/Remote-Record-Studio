# Vessel — local development environment (server side).
#
# Copy to `.env` (git-ignored) and adjust. `scripts/dev.sh` loads this file,
# and it is what `pnpm dev`, `pnpm dev:api`, `pnpm dev:web` and `pnpm db:push`
# run through. Browser-side settings (relays, storage server, branding) live
# in `artifacts/vessel/.env.example` instead.

# PostgreSQL connection string. The default matches the container started by
# `pnpm dev:db` (see compose.yaml). Point it at your own server if you prefer.
DATABASE_URL=postgresql://vessel:vessel@127.0.0.1:5434/vessel

# Port the Express API listens on.
API_PORT=3001

# Port the Vite dev server for the web client listens on.
WEB_PORT=5173

# Path the web client is served from. Use "/" unless you deploy under a prefix.
BASE_PATH=/

# Where the web dev server forwards /api/* requests. Defaults to the API above.
# VESSEL_API_PROXY_TARGET=http://localhost:3001

# pino log level for the API: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Live preview: TURN relay (optional, recommended for the flagship) ---
# Peers behind strict NATs need a TURN relay to see each other. Point these at
# a coturn instance running with `use-auth-secret` and the same secret; the API
# hands out short-lived credentials from GET /api/turn. Leave unset to use
# public STUN only.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SHARED_SECRET=change-me
# TURN_TTL_SECONDS=43200
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
